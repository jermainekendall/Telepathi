#version 450

// Each workgroup processes one 4KB block
// Dispatch with (numBlocks, 1, 1)

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

// Input: raw block data, packed as uint32 array
// Each block is 4096 bytes = 1024 uint32s
layout(std430, binding = 0) readonly buffer InputBlocks {
    uint data[];
} inputBlocks;

// Output: 8-byte (2 x uint32) truncated hash per block
layout(std430, binding = 1) writeonly buffer OutputHashes {
    uint hashes[];
} outputHashes;

// Push constant: number of bytes in the last block (may be < 4096)
layout(push_constant) uniform PushConstants {
    uint numBlocks;
    uint lastBlockSize;
} pc;

// SHA-256 constants
const uint K[64] = uint[64](
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
    0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
    0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
    0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
    0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
    0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
    0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
    0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
);

uint rotr(uint x, uint n) {
    return (x >> n) | (x << (32u - n));
}

uint Ch(uint x, uint y, uint z) {
    return (x & y) ^ (~x & z);
}

uint Maj(uint x, uint y, uint z) {
    return (x & y) ^ (x & z) ^ (y & z);
}

uint Sigma0(uint x) {
    return rotr(x, 2u) ^ rotr(x, 13u) ^ rotr(x, 22u);
}

uint Sigma1(uint x) {
    return rotr(x, 6u) ^ rotr(x, 11u) ^ rotr(x, 25u);
}

uint sigma0(uint x) {
    return rotr(x, 7u) ^ rotr(x, 18u) ^ (x >> 3u);
}

uint sigma1(uint x) {
    return rotr(x, 17u) ^ rotr(x, 19u) ^ (x >> 10u);
}

// Convert 4 bytes to big-endian uint32
uint toBigEndian(uint val) {
    return ((val & 0xFFu) << 24u) |
           ((val & 0xFF00u) << 8u) |
           ((val & 0xFF0000u) >> 8u) |
           ((val & 0xFF000000u) >> 24u);
}

// Process one 64-byte (512-bit) SHA-256 block
void processBlock(inout uint h[8], uint block[16]) {
    uint W[64];

    // Prepare message schedule
    for (int t = 0; t < 16; t++) {
        W[t] = block[t];
    }
    for (int t = 16; t < 64; t++) {
        W[t] = sigma1(W[t-2]) + W[t-7] + sigma0(W[t-15]) + W[t-16];
    }

    // Initialize working variables
    uint a = h[0], b = h[1], c = h[2], d = h[3];
    uint e = h[4], f = h[5], g = h[6], hh = h[7];

    // Compression
    for (int t = 0; t < 64; t++) {
        uint T1 = hh + Sigma1(e) + Ch(e, f, g) + K[t] + W[t];
        uint T2 = Sigma0(a) + Maj(a, b, c);
        hh = g; g = f; f = e; e = d + T1;
        d = c; c = b; b = a; a = T1 + T2;
    }

    h[0] += a; h[1] += b; h[2] += c; h[3] += d;
    h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
}

void main() {
    uint blockIdx = gl_GlobalInvocationID.x;
    if (blockIdx >= pc.numBlocks) return;

    // Determine block size
    uint blockSize = 4096u;
    if (blockIdx == pc.numBlocks - 1u && pc.lastBlockSize > 0u) {
        blockSize = pc.lastBlockSize;
    }

    uint baseOffset = blockIdx * 1024u; // 4096 bytes / 4 = 1024 uint32s per block

    // Initialize SHA-256 state
    uint h[8];
    h[0] = 0x6a09e667u; h[1] = 0xbb67ae85u;
    h[2] = 0x3c6ef372u; h[3] = 0xa54ff53au;
    h[4] = 0x510e527fu; h[5] = 0x9b05688cu;
    h[6] = 0x1f83d9abu; h[7] = 0x5be0cd19u;

    // Process complete 64-byte chunks
    uint fullChunks = blockSize / 64u;
    uint remainder = blockSize % 64u;

    for (uint chunk = 0u; chunk < fullChunks; chunk++) {
        uint block[16];
        for (int i = 0; i < 16; i++) {
            uint wordOffset = baseOffset + chunk * 16u + uint(i);
            block[i] = toBigEndian(inputBlocks.data[wordOffset]);
        }
        processBlock(h, block);
    }

    // Handle padding (SHA-256 requires padding to 512-bit boundary)
    // Simplified: for the last partial chunk + padding
    {
        uint block[16];
        for (int i = 0; i < 16; i++) block[i] = 0u;

        // Copy remaining bytes
        uint remainWords = (remainder + 3u) / 4u;
        for (uint i = 0u; i < remainWords && i < 16u; i++) {
            uint wordOffset = baseOffset + fullChunks * 16u + i;
            if (wordOffset < baseOffset + (blockSize + 3u) / 4u) {
                block[i] = toBigEndian(inputBlocks.data[wordOffset]);
            }
        }

        // Append 0x80 byte
        uint bitPos = remainder % 4u;
        uint wordIdx = remainder / 4u;
        if (wordIdx < 16u) {
            uint mask = 0x80000000u >> (bitPos * 8u);
            block[wordIdx] |= mask;
        }

        // If not enough room for length (need 8 bytes), process and start new block
        if (remainder >= 56u) {
            processBlock(h, block);
            for (int i = 0; i < 16; i++) block[i] = 0u;
        }

        // Append bit length (big-endian 64-bit)
        uint totalBits = blockSize * 8u;
        block[14] = 0u; // High 32 bits (always 0 for blocks <= 4KB)
        block[15] = totalBits;

        processBlock(h, block);
    }

    // Write truncated hash (first 8 bytes = 2 uint32s)
    uint outOffset = blockIdx * 2u;
    outputHashes.hashes[outOffset]     = h[0];
    outputHashes.hashes[outOffset + 1u] = h[1];
}
